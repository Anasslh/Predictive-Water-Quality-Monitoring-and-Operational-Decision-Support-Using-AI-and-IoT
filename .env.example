# SQL Server Warm Tier. This local-development example uses Windows integrated
# authentication and contains no password. In production, use a trusted server
# certificate and a secret manager/environment injection for any SQL login.
DB_CONN_STR="Driver={ODBC Driver 17 for SQL Server};Server=localhost\SQLEXPRESS;Database=NileWaterQuality_Warm;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;"

# Historical query scope. These values remain parameter-generic.
WQD_WARM_SITE_ID="C-1"
WQD_WARM_LOOKBACK_DAYS="365"
WQD_DB_TIMEOUT_SECONDS="5"
